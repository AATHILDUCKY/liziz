  "private": true,
  "description": "Liziz \u2014 premium modest womenswear, designed and manufactured in house. Next.js, SQLite, admin portal and WhatsApp checkout.",
  "scripts": {
    "dev": "node scripts/neturl.js && node scripts/init-db.js && next dev -H 0.0.0.0",
